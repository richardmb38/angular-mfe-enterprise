{
	"name": "saas-mfe-config-hub",
	"version": "0.0.0",
	"acme": {
		"moduleDemoUrl": "https://{orgName}.identitysoon.com/ui/ch/admin/config-hub?ui={buildNumber}",
		"deploy": {
			"bucket": "files.cloud.acme.com",
			"destPath": "modules/builds/saas-mfe-config-hub/{buildNumber}",
			"srcFolder": "dist/"
		},
		"mfeDeploy": {
			"bucket": "assets-dev.acme.com",
			"destPath": "saas-mfe-config-hub/{buildNumber}",
			"srcFolder": "dist/"
		},
		"deployContinuous": {
			"bucket": "assets-dev.acme.com",
			"destPath": "saas-mfe-config-hub",
			"srcFolder": "dist/"
		},
		"languagePackageSources": [
			"src/messages/*.json",
			"node_modules/@acme-priv/ui-common/src/acme/messages/IDENTITYNOW*.json",
			"node_modules/@acme-priv/armada-angular/src/acme/messages/ACME*.json"
		],
		"mfe": {
			"appShell": "idn:vanity",
			"entryFile": "",
			"mfeName": "saas-mfe-config-hub"
		},
		"moduleType": "",
		"prodBranches": [
			"main"
		],
		"whiteListedDeps": [
			"@angular-eslint/eslint-plugin"
		],
		"cypress": {
			"pendingTestsThreshold": 15
		}
	},
	"scripts": {
		"ng": "ng",
		"all": "npm run -s test && npm run -s lint && npm run -s build",
		"build": "node --max_old_space_size=2048 node_modules/@angular/cli/bin/ng run saas-mfe-config-hub:build --configuration production --aot",
		"build:app": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration production --aot",
		"build:mfe": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng run saas-mfe-config-hub:build-mfe:production --aot",
		"build:schematics": "cd node_modules/@acme-priv/armada-angular/schematics; npm run build",
		"bundle-report": "ng build --configuration production --aot --stats-json && webpack-bundle-analyzer dist/stats.json",
		"cypress:update-snapshot": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http://localhost:6006 && cypress run --env type=base --browser=chrome --headless -k -s first'",
		"cypress:open": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http://localhost:6006 && cypress open' -k -s first",
		"cypress": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http://localhost:6006 && cypress run --headless --browser=chrome --env type=actual' -k -s first",
		"cypress:cc": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http-get://localhost:6006/iframe.html && npx cypress run --record --key 199507d3-b0eb-40d8-9bd5-7d3b9b68ba1a --headless --browser=chrome --env type=actual' -k -s first",
		"cypress:record:parallel": "unset DISPLAY && xvfb-run -a npx cypress run --record --key 199507d3-b0eb-40d8-9bd5-7d3b9b68ba1a --parallel --headless --browser=chrome --env type=actual --ci-build-id",
		"deploy": "npm run build && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js && node node_modules/@acme-priv/npm-tools/etc/scripts/mfe.js",
		"deploy:app": "npm run build:app && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js && node node_modules/@acme-priv/npm-tools/etc/scripts/uiModule.js autoDeploy",
		"deploy:mfe": "npm run publish:mfe && node node_modules/@acme-priv/npm-tools/etc/scripts/mfe.js",
		"deploy:continuous-storybook": "npm run storybook:build && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js --prod continuous",
		"deploy:storybook": "npm run storybook:build && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js",
		"integration:ci": "npm run cypress:cc",
		"lint": "prettier \"./**/*.html\" --check && eslint . --ext .ts,.js,.html && npm run stylelint",
		"lint:ci": "npm run lint",
		"lint:fix": "prettier \"./**/*.html\" --write && eslint . --ext .ts,.js,.html --fix && npm run stylelint:fix",
		"publish:docs": "npm run deploy:continuous-storybook",
		"publish:mfe": "npm run build:mfe && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js deployAs=mfe",
		"npm:login": "echo \"npm:login will be removed, please follow next Artifactory Setup guide: https://acme.atlassian.net/wiki/spaces/ISC/pages/2864906392/Artifactory+Local+Setup\"",
		"pr:demo-links": "node node_modules/@acme-priv/npm-tools/etc/scripts/addDemosToPr.js --repoOwner=acme --repoName=saas-mfe-config-hub",
		"preinstall": "npm run npm:login",
		"prettier": "prettier \"./**/*{.ts,.js,.scss,.html}\" --check",
		"prettier:fix": "prettier \"./**/*{.ts,.js,.scss,.html}\" --write",
		"publish:uimodule": "npm run deploy",
		"setup:ci": "",
		"start": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng serve --configuration development",
		"start:mfe": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng serve --configuration development-mfe",
		"storybook:start": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng run saas-mfe-config-hub:storybook --open",
		"storybook:build": "node --max-old-space-size=6144 node_modules/@angular/cli/bin/ng run saas-mfe-config-hub:storybook-build",
		"storybook:wait": "npm run storybook:start --quiet & npx wait-on http-get://localhost:6006/iframe.html -l",
		"storybook:cypress": "node --max-old-space-size=6144 node_modules/@angular/cli/bin/ng run saas-mfe-config-hub:storybook --ci --quiet",
		"stylelint": "stylelint \"src/**/*.scss\"",
		"stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
		"test": "ng test --ci --coverage",
		"test:ci": "ng test --ci --coverage --silent",
		"test:debug": "ng test --watch",
		"test:jest": "ng test",
		"test:update-snapshot": "ng test --update-snapshot",
		"test:pull-request": "node node_modules/@acme-priv/npm-tools/etc/scripts/testPullRequest.js --repoOwner=acme --repoName=saas-mfe-config-hub",
		"uiModule": "node node_modules/@acme-priv/npm-tools/etc/scripts/uiModule.js"
	},
	"private": true,
	"dependencies": {
		"@angular/core": "^17.3.12",
		"@aws-sdk/client-secrets-manager": "^3.631.0",
		"@braintree/sanitize-url": "^6.0.4",
		"@ngrx/effects": "^17.2.0",
		"@ngrx/router-store": "^17.2.0",
		"@ngrx/schematics": "^17.2.0",
		"@ngrx/store": "^17.2.0",
		"@ngrx/entity": "^17.2.0",
		"@ngrx/store-devtools": "^17.2.0",
		"@acme-priv/armada-angular": "182.0.1",
		"@acme-priv/ui-common": "141.12.1",
		"@swimlane/ngx-charts": "^20.5.0",
		"@tinymce/tinymce-angular": "^8.0.0",
		"@types/jsonpath": "^0.2.0",
		"amazon-quicksight-embedding-sdk": "^1.20.0",
		"enigma.js": "2.12.0",
		"fast-json-patch": "^3.1.1",
		"file-saver": "^2.0.5",
		"glob": "^11.0.0",
		"gojs": "2.2.5",
		"gojs-angular": "2.0.7",
		"immer": "^9.0.15",
		"jest-image-snapshot": "^6.4.0",
		"jsonpath": "^1.1.1",
		"mime": "^4.0.4",
		"request": "^2.88.2",
		"single-spa": "^5.9.4",
		"single-spa-angular": "^9.0.1",
		"tinymce": "^7.1.2",
		"tslib": "^2.6.2",
		"zone.js": "~0.14.10"
	},
