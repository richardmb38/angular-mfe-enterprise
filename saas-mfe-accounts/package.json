{
	"name": "saas-mfe-accounts",
	"version": "0.0.0",
	"acme": {
		"moduleDemoUrl": "https://{orgName}.identitysoon.com/ui/am/admin/accounts-management?ui={buildNumber}",
		"deploy": {
			"bucket": "files.cloud.acme.com",
			"destPath": "modules/builds/saas-mfe-accounts/{buildNumber}",
			"srcFolder": "dist/"
		},
		"mfeDeploy": {
			"ACL": "private",
			"bucket": "assets-dev.acme.com",
			"destPath": "saas-mfe-accounts/{buildNumber}",
			"srcFolder": "dist/"
		},
		"deployContinuous": {
			"ACL": "private",
			"bucket": "assets-dev.acme.com",
			"destPath": "saas-mfe-accounts",
			"srcFolder": "dist/"
		},
		"languagePackageSources": [
			"src/messages/*.json",
			"node_modules/@acme-priv/ui-common/src/acme/messages/IDENTITYNOW*.json",
			"node_modules/@acme-priv/armada-angular/src/acme/messages/ACME*.json"
		],
		"mfe": {
			"appShell": "idn:vanity",
			"entryFile": "",
			"mfeName": "saas-mfe-accounts"
		},
		"moduleType": "",
		"prodBranches": [
			"main"
		],
		"whiteListedDeps": [
			"@angular-eslint/eslint-plugin"
		],
		"cypress": {
			"pendingTestsThreshold": 5
		}
	},
	"scripts": {
		"ng": "ng",
		"all": "npm run -s test && npm run -s lint && npm run -s build",
		"build": "node --max_old_space_size=2048 node_modules/@angular/cli/bin/ng run saas-mfe-accounts:build --configuration production --aot",
		"build:app": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration production --aot",
		"build:mfe": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng run saas-mfe-accounts:build-mfe:production --aot",
		"build:schematics": "cd node_modules/@acme-priv/armada-angular/schematics; npm run build",
		"bundle-report": "ng build --configuration production --aot --stats-json && webpack-bundle-analyzer dist/stats.json",
		"cypress:update-snapshot": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http://localhost:6006 && cypress run --env type=base --browser=chrome --headless -k -s first'",
		"cypress:open": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http://localhost:6006 && cypress open' -k -s first",
		"cypress": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http://localhost:6006 && cypress run --headless --browser=chrome --env type=actual' -k -s first",
		"cypress:cc": "unset DISPLAY && concurrently 'npm run storybook:start' 'wait-on http-get://localhost:6006/iframe.html && npx cypress run --record --key 532f0916-32ac-45d4-9f6f-93a6b636eb6d --headless --browser=chrome --env type=actual' -k -s first",
		"cypress:record:parallel": "unset DISPLAY && npx cypress run --record --key 532f0916-32ac-45d4-9f6f-93a6b636eb6d --parallel --headless --browser=chrome --env type=actual --ci-build-id",
		"deploy": "npm run build && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js && node node_modules/@acme-priv/npm-tools/etc/scripts/mfe.js",
		"deploy:app": "npm run build:app && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js && node node_modules/@acme-priv/npm-tools/etc/scripts/uiModule.js autoDeploy",
		"deploy:mfe": "npm run publish:mfe && node node_modules/@acme-priv/npm-tools/etc/scripts/mfe.js",
		"deploy:continuous-storybook": "npm run storybook:build && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js --prod continuous",
		"deploy:storybook": "npm run storybook:build && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js",
		"integration:ci": "npm run cypress:cc",
		"lint": "prettier \"./**/*.html\" --check && eslint . --ext .ts,.js,.html && npm run stylelint",
		"lint:ci": "npm run lint",
		"lint:fix": "prettier \"./**/*.html\" --write && eslint . --ext .ts,.js,.html --fix && npm run stylelint:fix",
		"publish:docs": "npm run deploy:continuous-storybook",
		"publish:mfe": "npm run build:mfe && node node_modules/@acme-priv/npm-tools/etc/scripts/deploy.js deployAs=mfe",
		"npm:login": "echo \"npm:login will be removed, please follow next Artifactory Setup guide: https://acme.atlassian.net/wiki/spaces/ISC/pages/2864906392/Artifactory+Local+Setup\"",
		"pr:demo-links": "node node_modules/@acme-priv/npm-tools/etc/scripts/addDemosToPr.js --repoOwner=acme --repoName=saas-mfe-accounts",
		"preinstall": "npm run npm:login",
		"prettier": "prettier \"./**/*{.ts,.js,.scss,.html}\" --check",
		"prettier:fix": "prettier \"./**/*{.ts,.js,.scss,.html}\" --write",
		"publish:uimodule": "npm run deploy",
		"setup:ci": "",
		"start": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng serve --configuration development",
		"start:mfe": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng serve --configuration development-mfe",
		"storybook:start": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng run saas-mfe-accounts:storybook --open",
		"storybook:build": "node --max-old-space-size=6144 node_modules/@angular/cli/bin/ng run saas-mfe-accounts:storybook-build",
		"storybook:cypress": "node --max-old-space-size=6144 node_modules/@angular/cli/bin/ng run saas-mfe-accounts:storybook --ci --quiet",
		"stylelint": "stylelint \"src/**/*.scss\"",
		"stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
		"test": "ng test --ci --coverage",
		"test:ci": "ng test --ci --coverage --silent",
		"test:debug": "ng test --watch",
		"test:jest": "ng test",
		"test:update-snapshot": "ng test --update-snapshot",
		"test:pull-request": "node node_modules/@acme-priv/npm-tools/etc/scripts/testPullRequest.js --repoOwner=acme --repoName=saas-mfe-accounts",
		"uiModule": "node node_modules/@acme-priv/npm-tools/etc/scripts/uiModule.js"
	},
	"private": true,
	"dependencies": {
		"@angular-eslint/eslint-plugin-template": "^14.1.2",
		"@angular-eslint/template-parser": "^14.1.2",
		"@angular/animations": "^17.3.12",
		"@angular/common": "^17.3.12",
		"@angular/compiler": "^17.3.12",
		"@angular/core": "^17.3.12",
		"@angular/forms": "^17.3.12",
		"@angular/platform-browser": "^17.3.12",
		"@angular/platform-browser-dynamic": "^17.3.12",
		"@angular/router": "^17.3.12",
		"@acme-priv/armada-angular": "179.2.2",
		"@acme-priv/ui-common": "138.7.1",
		"fast-json-patch": "^3.1.1",
		"rxjs": "^7.8.1",
		"single-spa": "^6.0.3",
		"single-spa-angular": "^9.0.1",
		"tslib": "^2.6.2",
		"zone.js": "~0.14.10"
	},
	"devDependencies": {
		"@angular-builders/custom-webpack": "^17.0.2",
		"@angular-builders/jest": "^17.0.2",
		"@angular-devkit/build-angular": "^17.3.11",
		"@angular-eslint/eslint-plugin": "^14.0.2",
		"@angular/cdk": "^16.2.11",
		"@angular/cli": "^17.3.11",
		"@angular/compiler-cli": "^17.3.12",
		"@angular/elements": "^17.3.12",
		"@angular/language-service": "^17.3.12",
		"@compodoc/compodoc": "^1.1.25",
		"@cypress/webpack-preprocessor": "^6.0.1",
		"@ngrx/eslint-plugin": "^17.2.0",
		"@acme-priv/npm-tools": "^7.5.17",
		"@storybook/addon-a11y": "^7.6.10",
		"@storybook/addon-docs": "^7.6.10",
		"@storybook/addon-essentials": "^7.6.10",
		"@storybook/addon-toolbars": "^7.6.10",
		"@storybook/addons": "^7.6.10",
		"@storybook/angular": "^7.6.10",
		"@storybook/blocks": "^7.6.10",
		"@storybook/theming": "^7.6.10",
		"@swimlane/ngx-charts": "^20.5.0",
		"@testing-library/cypress": "^10.0.1",
		"@testing-library/dom": "^9.3.4",
		"@testing-library/jest-dom": "^6.4.2",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/jest": "^29.5.1",
		"@types/node": "^20.11.10",
		"@typescript-eslint/eslint-plugin": "^6.19.1",
		"@typescript-eslint/parser": "^6.19.1",
		"autoprefixer": "^10.4.18",
		"circular-dependency-plugin": "^5.2.2",
		"codelyzer": "^6.0.2",
		"concurrently": "^8.2.2",
		"cross-spawn": "^7.0.3",
		"cypress": "^13.6.3",
		"cypress-file-upload": "^5.0.8",
		"cypress-visual-regression": "^3.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-html": "^7.1.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jest": "^27.6.3",
		"eslint-plugin-jsdoc": "^46.9.0",
		"eslint-plugin-n": "^16.6.2",
		"eslint-plugin-no-only-tests": "^3.1.0",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-promise": "^6.1.1",
		"eslint-plugin-storybook": "^0.8.0",
		"jest": "^29.7.0",
		"jest-canvas-mock": "^2.5.2",
		"jest-image-snapshot": "^6.4.0",
		"jest-junit": "^16.0.0",
		"jest-marbles": "3.0.6",
		"jest-preset-angular": "^13.1.4",
		"license-checker": "25.0.1",
		"mockdate": "3.0.5",
		"postcss": "^8.4.33",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.2.4",
		"request": "^2.88.2",
		"storybook": "^7.6.20",
		"storybook-addon-fetch-mock": "^1.0.1",
		"style-loader": "^3.3.4",
		"stylelint": "^15.11.0",
		"stylelint-config-recommended": "^13.0.0",
		"stylelint-prettier": "^4.0.2",
		"stylelint-scss": "5.3.1",
		"ts-jest": "^29.1.2",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths-webpack-plugin": "^4.1.0",
		"typedoc": "0.25.12",
		"typescript": "5.4.5",
		"wait-on": "^7.2.0",
		"webpack": "^5.91.0"
	}
}
