@Library('acme/jenkins-release-utils')_

// Only deploy to the following, by excluded them from the blacklist
def podBlackList = (utils.ALL_DEV_PODS - 'megapod-useast1' - 'dev01-useast1' - 'lighthouse' - 'bermuda').join(',')

/**
 * Jenkins release pipeline for saas-mfe-access-request
 */
 atlasServiceTemplate (
    service: "saas-mfe-access-request",
    slackChannel: "#bot-saas-ui",
    slackChannelFailures: "#team-eng-ui-on-call",
    // E2E TESTING
    runE2ETests: false,
    // API TESTING
    runAPITests: false,
    // BUILD
    nodeBuild: true,
    nodeVersion: '20',
    githubTagPrefix: 'mfe-release/',
    podBlackList: podBlackList,

    // CYPRESS TESTING on bermuda
     cypressTestNodeImageVersion: 'node:20-latest',
     cypressTestLighthouseTags: '',
     cypressTestLighthouseEnvironment: '',
     cypressTestBermudaEnvironment: 'bermuda-ui-e2e',
     cypressTestBermudaTags: 'saas-mfe-access-request',
     cypressTestThreadCount: '1',

    // JIRA
    jiraProduct: "IdentityNow",
    jiraProject: "UITRIAGE",
    jiraReleaseComponent: "saas-mfe-access-request",
    jiraApplication: "microfrontend"
)
