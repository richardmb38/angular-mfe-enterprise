			},
			{
				"name": "ACCESSREQUEST.json",
				"download": "src/messages/ACCESSREQUEST_{language}.json",
				"upload": "src/messages/ACCESSREQUEST.json",
				"order": 50
			}
		]
	},

	"github": {
		"org": "acme",
		"repo": "saas-mfe-access-request",
