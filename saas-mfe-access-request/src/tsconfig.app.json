{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"outDir": "../out-tsc/app",
		"baseUrl": "./",
		"types": []
	},
	"files": ["./main.ts", "./polyfills.ts"],
	"include": [
		"src/**/*.d.ts",
		"../node_modules/@acme-priv/armada-angular/src/**/*.ts",
		"../node_modules/@acme-priv/ui-common/src/**/*.ts"
	],
	"exclude": [
		"test.ts",
		"**/*.spec.ts",
		"**/*.mock.ts",
		"**/*.mocks.ts",
		"**/_mock_/*.ts",
		"../node_modules/@acme-priv/armada-angular/src/**/*.spec.ts",
		"../node_modules/@acme-priv/ui-common/src/**/*.spec.ts",
		"../node_modules/@acme-priv/armada-angular/**/*.stories.*",
		"../node_modules/@acme-priv/ui-common/**/*.stories.*",
		"**/*.stories.*",
		"**/cypress",
		"**/*.cypress.*",
		"../node_modules/@acme-priv/armada-angular/**/cypress",
		"../node_modules/@acme-priv/ui-common/**/cypress"
	]
}
